  "tutorial": {
    "steps": [
      {
        "title": "欢迎来到餐这儿",
        "icon": "star",
        "body": "这是一个外卖经营模拟游戏。订单会自动到来，员工会自动接单、烹饪、配送 —— 你的任务是管理好店铺，赚取更多利润！",
        "target": null,
        "placement": "center"
      },
      {
        "title": "这里是你的店铺主页",
        "icon": "store",
        "body": "这里展示今日营收、订单动态和厨房状态。订单会自动进入厨房，员工会自动处理 —— 你只需关注经营策略。",
        "target": "#p-shop",
        "placement": "top"
      },
      {
        "title": "查看你的资金",
        "icon": "coins",
        "body": "点击金币区域可以打开财务中心，查看收支明细、贷款和投资。资金是经营的核心 —— 有了钱才能扩张！",
        "target": "#top-money-area",
        "placement": "bottom"
      },
      {
        "title": "雇佣和管理员工",
        "icon": "users",
        "body": "点击「员工」标签，可以雇佣新员工来加快接单和烹饪速度。员工越多，出餐越快，但工资也是一笔开销。",
        "target": "#nav-tab-staff",
        "placement": "top"
      },
      {
        "title": "加盟扩张你的品牌",
        "icon": "briefcase",
        "body": "在「加盟招商」中，你可以开设分店、招商加盟，扩大品牌影响力。不同店铺有不同初始加成。",
        "target": "#nav-tab-franchise",
        "placement": "top"
      },
      {
        "title": "参加活动赚取奖励",
        "icon": "zap",
        "body": "「活动」中有各种限时玩法，如恶评猜疑、PK对战等。参加活动可以获得额外奖励和客流加成！",
        "target": "#nav-tab-activity",
        "placement": "top"
      },
      {
        "title": "个人中心",
        "icon": "user",
        "body": "在「我的」中查看成就、存档和游戏设置。记得随时存档，避免丢失进度！",
        "target": "#nav-tab-profile",
        "placement": "top"
      },
      {
        "title": "经营小贴士",
        "icon": "lightbulb",
        "body": "订单超时会差评，评分影响客流！前期稳扎稳打，攒钱雇佣员工、解锁菜品，逐步扩大经营规模。祝你生意兴隆！",
        "target": null,
        "placement": "center"
      }
    ],
    "cur": 0,
    "active": false
  },
